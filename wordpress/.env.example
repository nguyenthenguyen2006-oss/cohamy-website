# These are blank intentionally. Generate independent strong secrets.
COHAMY_DB_PASSWORD=
COHAMY_WEBHOOK_SECRET=
COHAMY_CMS_PORT=8081
COHAMY_CMS_URL=http://127.0.0.1:8081
COHAMY_PUBLIC_URL=https://cohamy.vn
COHAMY_PREVIEW_URL=http://127.0.0.1:3001
COHAMY_WEBHOOK_URL=http://host.docker.internal:3001/api/wordpress/webhook
