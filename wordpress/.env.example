# Pin image digests after testing on staging. Compose has not run on this Windows host (Docker absent).
COHAMY_DATABASE_IMAGE=mariadb:11.4
COHAMY_WORDPRESS_IMAGE=wordpress:php8.3-apache
COHAMY_CLI_IMAGE=wordpress:cli
