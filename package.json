{
  "name": "test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "crm:init": "node --require ./scripts/register-server-only.cjs --import tsx scripts/crm/init.ts",
    "crm:seed-qa": "node --require ./scripts/register-server-only.cjs --import tsx scripts/crm/seed-qa.ts",
    "test:crm": "node --require ./scripts/register-server-only.cjs --import tsx scripts/crm/verify-access.ts",
    "test:crm:browser": "node scripts/crm/verify-browser.mjs",
    "test:crm:build": "node scripts/crm/verify-build.mjs",
    "test:crm:work": "node --require ./scripts/register-server-only.cjs --import tsx scripts/crm/verify-work.ts",
    "test:crm:work-browser": "node scripts/crm/verify-work-browser.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sheet:init": "node --conditions=react-server --import tsx scripts/init-blog-sheet.ts",
    "sheet:seed-blog": "node --conditions=react-server --import tsx scripts/seed-existing-blog-to-sheet.ts",
    "admin:hash": "node --import tsx scripts/hash-admin-password.ts",
    "test:cms": "node --require ./scripts/register-server-only.cjs --import tsx scripts/verify-cms.ts",
    "headless:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wordpress/setup-local.ps1",
    "headless:local": "node scripts/wordpress/run-local.mjs",
    "headless:build": "node scripts/wordpress/build-local.mjs",
    "test:upgrade": "node scripts/verify-content-upgrade.mjs",
    "test:upgrade:public": "node scripts/verify-upgrade-public.mjs",
    "test:upgrade:editorial": "node scripts/verify-upgrade-editorial.mjs",
    "test:upgrade:export": "node scripts/verify-upgrade-export.mjs",
    "test:upgrade:queue": "node scripts/wordpress/test-queue.mjs",
    "test:upgrade:providers": "node scripts/wordpress/test-queue.mjs --providers",
    "test:rank-engine": "node scripts/verify-rank-engine.mjs",
    "blog:migrate": "node --require ./scripts/register-server-only.cjs --import tsx scripts/migrate-wordpress-blog.ts",
    "test:headless": "node --require ./scripts/register-server-only.cjs --import tsx scripts/verify-wordpress-e2e.ts",
    "test:headless:contract": "node --require ./scripts/register-server-only.cjs --import tsx scripts/verify-headless-contract.ts",
    "test:headless:operations": "node --require ./scripts/register-server-only.cjs --import tsx scripts/verify-headless-operations.ts",
    "test:upgrade:advanced": "node scripts/verify-upgrade-advanced.mjs",
    "test:upgrade:large-import": "node scripts/verify-upgrade-large-import.mjs",
    "test:upgrade:enhancements": "node scripts/verify-upgrade-enhancements.mjs",
    "test:upgrade:rollback": "node scripts/verify-upgrade-rollback.mjs",
    "test:upgrade:selection": "node scripts/verify-upgrade-selection.mjs",
    "test:headless:schedule": "node --require ./scripts/register-server-only.cjs --import tsx scripts/verify-wordpress-e2e.ts --only-schedule"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-image": "^3.29.1",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "googleapis": "^173.0.0",
    "jose": "^6.2.4",
    "jsdom": "^28.1.0",
    "lucide-react": "^1.21.0",
    "next": "16.3.5",
    "next-intl": "^4.13.0",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "postcss": "8.5.23",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.6",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "gaxios": "7.3.0"
  }
}
