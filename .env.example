NEXT_PUBLIC_SITE_URL=https://cohamy.vn
NODE_ENV=production
PORT=3001

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_POSTS_SHEET=Posts
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

UPLOAD_DIR=/var/www/cohamy_uploads/blog
NEXT_PUBLIC_UPLOAD_BASE_URL=https://cohamy.vn/uploads/blog

GOOGLE_SHEETS_WEBHOOK_URL=

# Explicit blog source: sheets (rollback), legacy (bundled static), wordpress.
BLOG_SOURCE=sheets
WORDPRESS_URL=https://cms.cohamy.vn
WORDPRESS_TIMEOUT_MS=8000
WORDPRESS_WEBHOOK_SECRET=
WORDPRESS_REPLAY_DIR=/var/lib/cohamy/webhook-replay
# Local test only; production CMS must use HTTPS.
WORDPRESS_ALLOW_LOCAL_HTTP=false
# Migration-only credentials, never used by public rendering or client components.
WORDPRESS_MIGRATION_USER=
WORDPRESS_APPLICATION_PASSWORD=
# Optional actual modification time for existing static marketing/product sitemap entries.
# Omit when no reliable edit timestamp exists; ISO 8601 with UTC/timezone.
SITE_CONTENT_UPDATED_AT=
# CRM access/catalog (independent of CMS and HumanBank)
# Use a dedicated empty Cohamy PostgreSQL database, not HumanBank's database.
CRM_DATABASE_MODE=postgres
CRM_DATABASE_URL=
CRM_PUBLIC_ORIGIN=
# LOCAL-only embedded test harness. Never use PGlite for production or multiple processes.
CRM_ENVIRONMENT=LOCAL
CRM_LOCAL_DATA_DIR=.local/crm-local
# Set bootstrap values in your shell; no default credentials.
CRM_BOOTSTRAP_EMAIL=
CRM_BOOTSTRAP_PASSWORD=
CRM_BOOTSTRAP_NAME=
# Opt-in intake only after migrations; this does not open sale/stock/finance posting.
CRM_WEBSITE_ORDER_INTAKE=false
