  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Orange work-form action; preview button does not save data.",
      "html": "<button type=\"button\" class=\"ds-primary\">Lưu thay đổi</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 16px;border:1px solid #bac7d1;border-radius:6px;min-height:42px;font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:13px;font-weight:600;text-decoration:none;line-height:1.4;cursor:pointer;transition:background-color 160ms ease,color 160ms ease;background:#b9420c;border-color:#b9420c;color:#fff}.ds-primary:hover{background:#983409}.ds-primary:active{background:#802906}.ds-primary:focus-visible{outline:3px solid #bf4b14;outline-offset:3px}.ds-primary:disabled{opacity:.6;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined white secondary action with the current quiet hover.",
      "html": "<button type=\"button\" class=\"ds-secondary\">Quay lại</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 16px;border:1px solid #bac7d1;border-radius:6px;min-height:42px;font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:13px;font-weight:600;text-decoration:none;line-height:1.4;cursor:pointer;transition:background-color 160ms ease,color 160ms ease;background:#fff;color:#182538}.ds-secondary:hover{background:#eef2f5}.ds-secondary:focus-visible{outline:3px solid #bf4b14;outline-offset:3px}.ds-secondary:disabled{opacity:.6;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "field",
      "description": "Explicit label, white outlined input and shared keyboard focus; no invented error-border variant.",
      "html": "<label class=\"ds-field\" for=\"ds-task-title\">Việc cần làm<input id=\"ds-task-title\" class=\"ds-field-input\" name=\"title\" placeholder=\"Ví dụ: gọi lại xác nhận số lượng\" /></label>",
      "css": ".ds-field{display:grid;gap:7px;color:#182538;font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:12px;font-weight:500;line-height:1.6}.ds-field-input{min-width:0;min-height:42px;border:1px solid #aebbc7;background:#fff;color:#182538;padding:9px 11px;border-radius:5px;font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:14px;font-weight:400;line-height:1.5;caret-color:#b9420c}.ds-field-input::placeholder{color:#667485}.ds-field-input:focus-visible{outline:3px solid #bf4b14;outline-offset:3px}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Representative active/default sidebar rows; fragment links are preview destinations. Icons are omitted from this text-state primitive.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Điều hướng mẫu\"><a class=\"ds-nav-link\" href=\"#ds-desk\" aria-current=\"page\">Bàn làm việc</a><a class=\"ds-nav-link\" href=\"#ds-orders\">Yêu cầu đặt hàng</a></nav>",
      "css": ".ds-navigation{display:grid;gap:5px;background:#172b43;padding:24px 14px 18px;font-family:'Be Vietnam Pro',system-ui,sans-serif;line-height:1.6}.ds-nav-link{display:flex;align-items:center;gap:12px;padding:11px 13px;color:#dae4ee;text-decoration:none;border-radius:6px;font-size:13px}.ds-nav-link[aria-current=page]{background:#fff;color:#172b43;font-weight:600}.ds-nav-link:hover:not([aria-current=page]){background:#243e58;color:#fff}.ds-nav-link:focus-visible{outline:3px solid #bf4b14;outline-offset:3px}"
    },
    {
      "name": "Request status",
      "kind": "chip",
      "refersTo": "status",
      "description": "Four non-interactive request status variants with written labels; ready is not a stock or financial posting.",
      "html": "<div class=\"ds-status-sample\"><span class=\"ds-status ds-pending\">Mới nhận</span> <span class=\"ds-status ds-progress\">Đang tư vấn</span> <span class=\"ds-status ds-ready\">Đã chốt yêu cầu</span> <span class=\"ds-status ds-rejected\">Từ chối</span></div>",
      "css": ".ds-status-sample{font-family:'Be Vietnam Pro',system-ui,sans-serif;line-height:1.6}.ds-status{display:inline-flex;border-radius:5px;background:#eef2f6;color:#455366;padding:5px 8px;white-space:nowrap;font-size:11px;font-weight:500}.ds-pending{background:#fff0df;color:#854509}.ds-progress{background:#eaf1ff;color:#244d8b}.ds-ready{background:#e6f5ed;color:#175f40}.ds-rejected{background:#fff0ef;color:#9d2929}"
    },
    {
      "name": "Work section",
      "kind": "card",
      "refersTo": "section",
      "description": "Flat white task group with a heading and actual empty-record copy.",
      "html": "<section class=\"ds-section\"><h2 class=\"ds-section-title\">Việc tiếp theo</h2><p class=\"ds-section-help\">Chưa có việc tiếp theo cho hồ sơ này. Thêm việc và hạn hoàn thành ngay bên dưới.</p></section>",
      "css": ".ds-section{background:#fff;color:#182538;border:1px solid #dbe2e8;border-radius:10px;padding:24px;margin-bottom:24px;min-width:0;font-family:'Be Vietnam Pro',system-ui,sans-serif;line-height:1.6}.ds-section-title{font-size:17px;font-weight:600;line-height:1.45;margin:0 0 20px}.ds-section-help{font-size:12px;color:#586577;line-height:1.7;margin:0}@media(max-width:760px){.ds-section{padding:18px;margin-bottom:18px;border-radius:8px}.ds-section-title{font-size:16px}}"
    },
    {
      "name": "Inline disclosure",
      "kind": "custom",
